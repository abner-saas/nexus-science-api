{
  "name": "nexus-science-api",
  "version": "0.1.0",
  "description": "Nexus Science API - Fastify + Drizzle",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
