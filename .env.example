# Produção: o conteúdo deste arquivo vai no GitHub Environment secret APP_ENV
# (não no git, não editar na VPS). Local: copie para nexus-science-api/.env
NODE_ENV=development
PORT=3333
HOST=0.0.0.0

# PostgreSQL
DATABASE_URL=postgresql://nexus:CHANGE_ME_DB_PASSWORD@localhost:5432/nexus_science

# JWT — use secrets com 64+ caracteres (openssl rand -base64 64)
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_64_CHARS________________________________
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_64_CHARS_______________________________
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Criptografia em repouso (AES-256-GCM) — 32 bytes em hex (64 chars)
# openssl rand -hex 32
FIELD_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# CORS — domínio do frontend na Vercel (nunca use *)
# O scheme do app (nexusscience://) e, em development, exp:// e o Metro em
# host privado (porta 8081/8082/19000/19006) entram no código
# (src/lib/mobile-origins.ts). Não liste isso aqui e não use *.
CORS_ORIGIN=http://localhost:3000

# Cookie
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
# "strict" quando front e API estão no mesmo domínio raiz; "none" (+ COOKIE_SECURE=true)
# quando estão em domínios diferentes (ex.: front na Vercel, API em domínio próprio)
COOKIE_SAME_SITE=strict

# Asaas — header access_token. A base precisa incluir /v3.
# Sem ASAAS_API_KEY, POST /checkout/sessions responde 503 AsaasNotConfigured
# e não grava payment. A URL de sucesso é a invoiceUrl da cobrança, não plans.checkoutUrl.
# Sandbox oficial: https://api-sandbox.asaas.com/v3
# O host abaixo ainda responde e segue como default deste repo.
# Produção: https://api.asaas.com/v3 (não usar chave de sandbox nesse host).
ASAAS_API_KEY=YOUR_ASAAS_API_KEY_HERE
ASAAS_WEBHOOK_TOKEN=CHANGE_ME_ASAAS_WEBHOOK_TOKEN
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3

# IA (OpenAI ou Gemini)
AI_PROVIDER=openai
OPENAI_API_KEY=sk_test_YOUR_KEY_HERE
# GEMINI_API_KEY=YOUR_GEMINI_KEY_HERE

# Seed do admin (apenas desenvolvimento)
SEED_ADMIN_EMAIL=admin@nexusscience.local
SEED_ADMIN_PASSWORD=ChangeMeAdmin123!
SEED_ADMIN_NAME=Abner Lucas

# Better Auth + Google
# Local:  http://localhost:3333/api/auth/callback/google
# Prod:   https://api-abner-saas.patitow.dev/api/auth/callback/google
# (os dois URIs no mesmo client OAuth, ou um client por ambiente — ver DEPLOY.md §6)
BETTER_AUTH_SECRET=CHANGE_ME_BETTER_AUTH_SECRET_MIN_32_CHARS________
BETTER_AUTH_URL=http://localhost:3333
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE

# Expo Push — opcional. Sem este valor notifyUsers só loga o prefixo do token.
# Com ele, o envio sai de verdade via expo-server-sdk (Expo Push API).
# Falha de push continua best-effort e não derruba o request.
# Não commitar token real. Gere em https://expo.dev/accounts/[account]/settings/access-tokens
# EXPO_ACCESS_TOKEN=YOUR_EXPO_ACCESS_TOKEN_HERE
